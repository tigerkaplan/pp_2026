{
  "compilerOptions": {
    /* Language & Emit */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* Module system (Next.js 16 / Turbopack) */
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* JSX */
    "jsx": "react-jsx",

    /* Paths & Aliases */
    
    "paths": {
      "@/*": ["./*"]
    },

    /* Incremental */
    "incremental": true,

    /* Next.js plugin */
    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}